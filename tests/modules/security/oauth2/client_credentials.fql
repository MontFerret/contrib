USE SECURITY::OAUTH2 AS oauth2

LET provider = oauth2::PROVIDER({
  tokenEndpoint: @lab.mock.api + "/oauth/token",
  insecureAllowHTTP: true
})
LET client = oauth2::CLIENT(provider, {
  clientID: "test-client",
  clientSecret: "test-secret"
})

T::EQ(provider.tokenEndpoint, @lab.mock.api + "/oauth/token")
T::EQ(client.clientID, "test-client")
T::EQ(client.authMethod, "client_secret_basic")
T::TRUE(client.hasClientSecret)

// Lab's current mock server only decodes JSON request bodies. Exercise the
// real form POST here and recover its expected 400; the module-level Go test
// covers the same flow against a form-aware server and asserts the token and
// Authorization header.
LET token = oauth2::CLIENT_CREDENTIALS(client, {
  scope: ["users:read"]
}) ON ERROR RETURN NONE
T::NONE(token)

RETURN NONE
