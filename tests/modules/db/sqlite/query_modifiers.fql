let db = DB::SQLITE::OPEN({ memory: true })

let create = query one `CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT NOT NULL)` in db using sql_exec
let firstInsert = query one `INSERT INTO users(name) VALUES (?)` in db using sql_exec
    with { params: ["Ada"] }
let secondInsert = query one `INSERT INTO users(name) VALUES (?)` in db using sql_exec
    with { params: ["Grace"] }

let first = query one `
  SELECT id, name
  FROM users
  ORDER BY id
` in db using sql

let count = query count `
  SELECT id
  FROM users
` in db using sql

let exists = query exists `
  SELECT id
  FROM users
  WHERE name = ?
` in db using sql
    with { params: ["Grace"] }

T::EQ(first.name, "Ada")
T::EQ(count, 2)
T::TRUE(exists)

return none

