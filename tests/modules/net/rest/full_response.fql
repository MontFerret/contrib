let api = NET::REST::CLIENT({ baseUrl: @lab.mock.api, encoding: "json" })

let response = query one "/health" in api options { response: "full" }

T::TRUE(response.ok)
T::EQ(response.status, 200)
T::EQ(response.body.version, "1.0.0")
T::EQ(response.body.status, "ok")
T::EQ(response.url, @lab.mock.api + "/health")

return none

