let page = DOCUMENT(@lab.static.dynamic + "/#/lists", { driver: "cdp" })

let first = waitfor value query one ".track[data-index='0']" in page using css timeout 10s every 250ms on timeout return none

T::NOT::NONE(first)

let count = query count ".track" in page using css

T::EQ(count, 20)

T::TRUE(query exists ".track[data-index='19']" in page using css)
T::FALSE(query exists ".track[data-index='20']" in page using css)

return true

