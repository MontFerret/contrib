let url = @lab.static.dynamic + "?redirect=/events"
let doc = DOCUMENT(url, { driver: "cdp" })

WAIT_ELEMENT(doc, "#page-events")

// with fixed timeout
CLICK(doc, "#wait-no-class-btn")
WAIT(1000)
WAIT_NO_ATTR(
    doc,
    X("//*[@id='wait-no-class-content']"),
    "class",
    "alert alert-success"
)

// with random timeout
CLICK(doc, "#wait-no-class-random-btn")
WAIT_NO_ATTR(
    doc,
    X("//*[@id='wait-no-class-random-content']"),
    "class",
    "alert alert-success",
    10000
)

return none

