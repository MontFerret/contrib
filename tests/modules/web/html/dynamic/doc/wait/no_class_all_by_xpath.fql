let url = @lab.static.dynamic + "?redirect=/events"
let doc = DOCUMENT(url, { driver: "cdp" })

WAIT_ELEMENT(doc, "#page-events")

CLICK_ALL(doc, "#wait-no-class-btn, #wait-no-class-random-btn")
WAIT_NO_CLASS_ALL(
    doc,
    X("//*[@id='wait-no-class-content' or @id='wait-no-class-random-content']"),
    "alert-success",
    10000
)

return none