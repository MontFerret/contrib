let url = @lab.static.dynamic + "?redirect=/events"
let doc = DOCUMENT(url, { driver: "cdp" })

WAIT_ELEMENT(doc, "#page-events")

CLICK_ALL(doc, "#wait-class-btn, #wait-class-random-btn")
WAIT_ATTR_ALL(
    doc,
    "#wait-class-content, #wait-class-random-content",
    "class",
    "alert alert-success",
    10000
)

return true