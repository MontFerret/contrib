let loaded = @lab.static.static + "/base-url.html"
let current = @lab.static.static + "/url-current?state=1#live"
let page = DOCUMENT(loaded, { driver: "cdp" })

WAIT_ELEMENT(page, "iframe[name='url-frame']")

let doc = page.document
let frame = arrays::first(FRAMES(page, "name", "url-frame"))
let base = @lab.static.static + "/url-assets/"
let frameURL = @lab.static.static + "/base-url-frame.html"
let frameBase = @lab.static.static + "/frame-assets/"

T::EQ(URL(page), current)
T::EQ(URL(doc), current)
T::EQ(BASE_URL(page), base)
T::EQ(BASE_URL(doc), base)
T::EQ(RESOLVE_URL(page, "images/logo.png"), base + "images/logo.png")
T::EQ(
    RESOLVE_URL(doc, "/images/logo.png"),
    @lab.static.static + "/images/logo.png"
)
T::EQ(URL(frame), frameURL)
T::EQ(BASE_URL(frame), frameBase)
T::EQ(RESOLVE_URL(frame, "frame.png"), frameBase + "frame.png")

return none

