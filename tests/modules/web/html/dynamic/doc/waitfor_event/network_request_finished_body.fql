let url = @lab.static.dynamic + "/#/events"
let page = DOCUMENT(url, { driver: "cdp" })

INPUT(page, "#ajax-input", "index.html")
CLICK(page, "#ajax-input-button")

let evt = waitfor event "network.request_finished" in page options {
    captureBody: true,
    bodyLimit: 15
} when CONTAINS(.url, "index.html") and .status == 200 and .type == "fetch" timeout 10s

T::NOT::NONE(evt.body)

return T::EQ(
    { event: evt.event, status: evt.status, bodyTruncated: evt.bodyTruncated },
    { event: "network.request_finished", status: 200, bodyTruncated: true }
)

