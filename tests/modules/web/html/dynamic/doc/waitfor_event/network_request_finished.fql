let url = @lab.static.dynamic + "/#/events"
let page = DOCUMENT(url, { driver: "cdp" })

INPUT(page, "#ajax-input", "index.html")
CLICK(page, "#ajax-input-button")

let evt = waitfor event "network.request_finished" in page when CONTAINS(
    .url,
    "index.html"
) and .status == 200 and .type == "fetch" timeout 10s

T::TRUE(CONTAINS(evt.url, "index.html"))

return T::EQ(
    {
        event: evt.event,
        method: evt.method,
        status: evt.status,
        type: evt.type,
        failed: evt.failed
    },
    {
        event: "network.request_finished",
        method: "GET",
        status: 200,
        type: "fetch",
        failed: false
    }
)

