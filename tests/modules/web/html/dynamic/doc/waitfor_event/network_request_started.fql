let url = @lab.static.dynamic + "/#/events"
let page = DOCUMENT(url, { driver: "cdp" })

INPUT(page, "#ajax-input", "index.html")
CLICK(page, "#ajax-input-button")

let evt = waitfor event "network.request_started" in page when CONTAINS(
    .url,
    "index.html"
) and .method == "GET" and .type == "fetch" timeout 10s

T::TRUE(CONTAINS(evt.url, "index.html"))

return T::EQ(
    { event: evt.event, method: evt.method, type: evt.type, failed: evt.failed },
    {
        event: "network.request_started",
        method: "GET",
        type: "fetch",
        failed: false
    }
)

