let url = @lab.static.dynamic + "/#/events"
let page = DOCUMENT(url, { driver: "cdp" })

CLICK(page, "#ajax-input-seq-buttons")

waitfor event "network.request_started" in page when CONTAINS(.url, "index.html") and .type == "fetch" timeout 10s

let evt = waitfor event "network.idle" in page options {
    quiet: 2500,
    maxInflight: 0,
    types: ["fetch"]
} timeout 10s

return T::EQ(
    {
        event: evt.event,
        inflight: evt.inflight,
        maxInflight: evt.maxInflight,
        quiet: evt.quiet
    },
    { event: "network.idle", inflight: 0, maxInflight: 0, quiet: 2500 }
)

