let url = @lab.static.dynamic + "?redirect=/media"
let expectedW = 1920
let expectedH = 1080

let doc = DOCUMENT(
    url,
    { driver: "cdp", viewport: { width: expectedW, height: expectedH } }
)

let actualW = TO_INT(INNER_TEXT(doc, "#screen-width"))
let actualH = TO_INT(INNER_TEXT(doc, "#screen-height"))

T::EQ(actualW, expectedW)
T::EQ(actualH, expectedH)

return none