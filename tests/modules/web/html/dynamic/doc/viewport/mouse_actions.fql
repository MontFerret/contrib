let url = @lab.static.dynamic + "?redirect=/events"
let doc = DOCUMENT(url, { driver: "cdp", viewport: { width: 320, height: 240 } })

WAIT_ELEMENT(doc, "#page-events")

T::TRUE(MOUSE(doc, 20, 30))
T::FALSE(MOUSE(doc, 20, 30))

T::TRUE(MOUSE(doc, 9999, 9999))
T::FALSE(MOUSE(doc, 10000, 10000))

T::TRUE(MOUSE(doc, -10, -10))
T::FALSE(MOUSE(doc, -20, -20))

return none

