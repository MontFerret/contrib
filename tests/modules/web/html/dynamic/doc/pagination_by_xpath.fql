let url = @lab.static.dynamic + "/#/pagination"
let page = DOCUMENT(url, { driver: "cdp" })

let items = (
    for i in PAGINATION(
        page,
        X(
            "//li[contains(@class, 'page-item-next') and contains(@class, 'page-item') and not(contains(@class, 'disabled'))]"
        )
    )
        return i
)

return T::LEN(items, 5)