let url = @lab.static.dynamic + "?redirect=/iframe&src=/forms"
let page = DOCUMENT(url, { driver: "cdp" })

WAIT_ELEMENT(page, "iframe[name='nested']")

let frames = (
    for f in page.frames
        filter f.name == "nested"
        limit 1
        return f
)
let doc = arrays::first(frames)

WAIT_ELEMENT(doc, "form")

let output = ELEMENT(doc, "#text_output")

INPUT(doc, "#text_input", "foo")

return T::EQ(output.innerText, "foo")

