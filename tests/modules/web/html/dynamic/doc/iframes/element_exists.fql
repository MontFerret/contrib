let url = @lab.static.dynamic + "?redirect=/iframe"
let page = DOCUMENT(url, { driver: "cdp" })

WAIT_ELEMENT(page, "iframe[name='nested']")

let frames = (
    for f in page.frames
        filter f.name == "nested"
        limit 1
        return f
)

let doc = arrays::first(frames)

T::NOT::NONE(doc)
T::TRUE(ELEMENT_EXISTS(doc, ".text-center"))
T::FALSE(ELEMENT_EXISTS(doc, ".foo-bar"))

return none

