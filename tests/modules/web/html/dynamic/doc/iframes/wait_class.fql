let url = @lab.static.dynamic + "?redirect=/iframe&src=/events"
let page = DOCUMENT(url, { driver: "cdp" })

WAIT_ELEMENT(page, "iframe[name='nested']")

let frames = (
    for f in page.frames
        filter f.name == "nested"
        limit 1
        return f
)
let doc = arrays::first(frames)

WAIT_ELEMENT(doc, "#page-events")

// with fixed timeout
CLICK(doc, "#wait-class-btn")
WAIT_CLASS(doc, "#wait-class-content", "alert-success")

// with random timeout
CLICK(doc, "#wait-class-random-btn")
WAIT_CLASS(doc, "#wait-class-random-content", "alert-success", 10000)

return ""

