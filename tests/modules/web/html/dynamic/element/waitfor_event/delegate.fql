let url = @lab.static.dynamic + "/#/events"
let page = DOCUMENT(url, { driver: "cdp" })
let root = ELEMENT(page, "#observable-delegate-root")

CLICK(page, "#observable-delegate-btn")

let evt = waitfor event "ferret:delegate" in root options {
    delegate: ".observable-delegate-item"
}

return T::EQ(
    { type: evt.type, scope: evt.detail.scope },
    { type: "ferret:delegate", scope: "match" }
)

