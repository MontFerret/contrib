LET url = @lab.static.dynamic + "/#/events"
LET page = DOCUMENT(url, { driver: "cdp" })
LET target = ELEMENT(page, "#observable-element-target")

LET evt = WAITFOR EVENT "ferret:sequence" IN target
    WHEN .detail.index == 2
    TRIGGER CLICK(page, "#observable-sequence-btn")

RETURN T::EQ(evt.detail.index, 2)
