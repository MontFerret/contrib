let url = @lab.static.dynamic + "/#/events"
let page = DOCUMENT(url, { driver: "cdp" })
let root = ELEMENT(page, "#observable-target-selector-root")

CLICK(page, "#observable-target-selector-btn")

let evt = waitfor event "ferret:target-selector" in root options {
    targetSelector: ".observable-target-selector-child"
} timeout 500ms

return T::EQ(
    { type: evt.type, scope: evt.detail.scope },
    { type: "ferret:target-selector", scope: "child" }
)

