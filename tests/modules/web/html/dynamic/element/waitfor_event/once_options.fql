let url = @lab.static.dynamic + "/#/events"
let page = DOCUMENT(url, { driver: "cdp" })
let target = ELEMENT(page, "#observable-element-target")

let status = waitfor event "ferret:sequence" in target options {
    listener: { once: true }
} when .detail.index == 2 trigger CLICK(page, "#observable-sequence-btn") timeout 500ms on timeout return "timeout"

return T::EQ(status, "timeout")

