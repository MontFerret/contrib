LET url = @lab.static.dynamic + "/#/events"
LET page = DOCUMENT(url, { driver: "cdp" })
LET target = ELEMENT(page, "#observable-element-target")

LET status = WAITFOR EVENT "ferret:sequence" IN target
    OPTIONS { listener: { once: true } }
    WHEN .detail.index == 2
    TRIGGER CLICK(page, "#observable-sequence-btn")
    TIMEOUT 500ms ON TIMEOUT RETURN "timeout"

RETURN T::EQ(status, "timeout")
