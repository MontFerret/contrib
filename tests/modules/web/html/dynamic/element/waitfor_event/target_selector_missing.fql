let url = @lab.static.dynamic + "/#/events"
let page = DOCUMENT(url, { driver: "cdp" })
let root = ELEMENT(page, "#observable-target-selector-root")

let status = waitfor event "ferret:target-selector" in root options {
    targetSelector: ".observable-target-selector-missing"
} timeout 200ms on timeout return "timeout" on error return "error"

return T::EQ(status, "error")

