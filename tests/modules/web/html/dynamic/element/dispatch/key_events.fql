let url = @lab.static.dynamic + "/#/events"
let page = DOCUMENT(url, { driver: "cdp" })
let input = ELEMENT(page, "#press-input")

dispatch "keydown" in input with { key: "Enter" }
dispatch "keyup" in input with { key: "Enter" }

WAIT(100)

return T::EQ(INNER_TEXT(page, "#press-content"), "Enter")

