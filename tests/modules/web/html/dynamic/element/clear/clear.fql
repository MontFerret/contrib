let url = @lab.static.dynamic + "?redirect=/forms"
let doc = DOCUMENT(url, { driver: "cdp" })

WAIT_ELEMENT(doc, "form")

let input = ELEMENT(doc, "#text_input")

INPUT(input, "Foo", 100)

INPUT_CLEAR(input)

T::EMPTY(INNER_TEXT(doc, "#text_output"))

INPUT(input, "test0-test1", 100)

INPUT_CLEAR(input)

T::EMPTY(INNER_TEXT(doc, "#text_output"))

INPUT(input, "test0&test1", 100)

INPUT_CLEAR(input)

T::EMPTY(INNER_TEXT(doc, "#text_output"))

return none