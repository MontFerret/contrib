let url = @lab.static.dynamic
let doc = DOCUMENT(url, { driver: "cdp" })
let el = ELEMENT(doc, ".jumbotron")

let expected = `Foobar`
INNER_TEXT_SET(el, expected)
WAIT(100)
let actual = INNER_TEXT(el)

let r1 = "(\n|\\s)"
let r2 = "(\n|\\s)"

return T::EQ(
    REGEX_REPLACE(TRIM(actual), r2, ""),
    REGEX_REPLACE(expected, r1, "")
)