let url = @lab.static.static + "/simple.html"
let doc = DOCUMENT(url)
let el = ELEMENT(doc, "body")

let expected = `<h1>Hello world</h1>`
let actual = INNER_HTML(el)

let r1 = "(\\s|\\"")"
let r2 = "(\n|\\s|\\"")"

T::EQ(REGEX_REPLACE(TRIM(actual), r2, ""), REGEX_REPLACE(expected, r1, ""))

return none