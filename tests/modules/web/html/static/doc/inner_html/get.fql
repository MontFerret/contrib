let url = @lab.static.static + "/simple.html"
let doc = DOCUMENT(url)

let expected = `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <title>Title</title>
</head>
<body>
    <h1>Hello world</h1>
</body>
</html>`
let actual = INNER_HTML(doc)

let r1 = "(\\s|\\"")"
let r2 = "(\n|\\s|\\"")"

return T::EQ(
    REGEX_REPLACE(TRIM(actual), r2, ""),
    REGEX_REPLACE(expected, r1, "")
)